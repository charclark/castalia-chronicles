// Castalia Chronicles — Prisma schema
// Database: PostgreSQL (Railway separate service, URL configured in prisma.config.ts and via PrismaClient adapter)
// NEVER use SQLite or any file-based database — the app folder is wiped on redeploy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- User model (authentication) ---
// Visitors never log in; only admin users do.
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Universe ---
// One per book series. All story-bible data belongs to exactly one universe
// via universeId foreign key. Universes are fully isolated.
model Universe {
  id             String          @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  storylineIdeas StorylineIdea[]
  notes          Note[]
  plotItems      PlotItem[]
}

// --- Storyline Ideas ---
model StorylineIdea {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title      String
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- General Notes ---
model Note {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title      String
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- Plot Checklist ---
// Universe-wide checklist. Checked items display small/grey at the bottom.
model PlotItem {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  text       String
  checked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}
