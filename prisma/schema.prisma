// Castalia Chronicles — Prisma schema
// Database: PostgreSQL (Railway separate service, URL configured in prisma.config.ts and via PrismaClient adapter)
// NEVER use SQLite or any file-based database — the app folder is wiped on redeploy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- User model (authentication) ---
// Visitors never log in; only admin users do.
// isSuperAdmin: true only for Char — bypasses password rules and has full access.
model User {
  id                  String           @id @default(cuid())
  username            String           @unique
  password            String
  isSuperAdmin        Boolean          @default(false)
  forcePasswordChange Boolean          @default(false)
  sessionVersion      Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  universeAccess      UniverseAccess[]
  createdUniverses    Universe[]       @relation("UniverseCreator")
  archivedUniverses   Universe[]       @relation("UniverseArchiver")
  workShares          WorkShare[]
  feedbackShares      FeedbackShare[]
  authorProfile       AuthorProfile?
  freeReadSubmissions         FreeReadSubmission[]
  discoverBooksSubmissions    DiscoverBooksSubmission[]
}

// --- Universe ---
// One per book series. All story-bible data belongs to exactly one universe
// via universeId foreign key. Universes are fully isolated.
// isPrivate: true = only Char can see it; false = can be shared with other users.
// createdByUserId: null = created by Char (pre-ownership) or Char herself.
// archivedAt/archivedByUserId: set when a non-super-admin "deletes" their universe
// (archived universes are hidden from all users except Char).
model Universe {
  id               String           @id @default(cuid())
  name             String
  description      String?
  isPrivate        Boolean          @default(true)
  createdByUserId  String?
  createdBy        User?            @relation("UniverseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?            @relation("UniverseArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  storylineIdeas   StorylineIdea[]
  notes            Note[]
  plotItems        PlotItem[]
  characters       Character[]
  locations        Location[]
  images           Image[]
  works            Work[]
  accesses         UniverseAccess[]
  species          Species[]
  customRoles      CustomRole[]

  @@index([createdByUserId])
  @@index([archivedAt])
}

// --- Universe Access ---
// Grants a non-super-admin user access to a specific universe.
// permission: "view" = read-only; "edit" = read and write.
// Only created/modified/deleted by the super-admin.
model UniverseAccess {
  id          String   @id @default(cuid())
  universeId  String
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String   // "view" | "edit"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([universeId, userId])
  @@index([universeId])
  @@index([userId])
}

// --- Characters ---
// Rich character profiles. characterType is one of: Vampire, Human, Wizard,
// Werewolf, Shapeshifter, Ghost, Other. subtype is a free-text kind/subtype.
// Relationships are stored in CharacterRelationship and link to other characters
// in the SAME universe — used by the auto-drawn Connections Map.
model Character {
  id              String   @id @default(cuid())
  universeId      String
  universe        Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  // Identity
  name            String
  characterType   String   @default("Human")
  subtype         String?

  // Appearance
  hairColor       String?
  eyeColor        String?
  bodyType        String?

  // Personality
  attitude        String?
  quirks          String?
  speakingStyle   String?
  phrases         String?  // frequently said phrases

  // Background
  origin          String?
  livesIn         String?
  homeDescription String?

  // Life
  vehicles        String?
  jobs            String?
  pets            String?

  // General
  notes           String?

  // Relationships (see CharacterRelationship)
  relFrom         CharacterRelationship[] @relation("RelFrom")
  relTo           CharacterRelationship[] @relation("RelTo")

  // Narrative roles (see CharacterRole)
  roles           CharacterRole[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([universeId])
}

// --- Character Roles ---
// Each row assigns one role name to one character.
// Role names are either from the default list or from CustomRole.
model CharacterRole {
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        String    // e.g. "Protagonist", "Supporting", or a custom role name

  @@id([characterId, role])
  @@index([characterId])
}

// --- Custom Roles ---
// Role names added by the super-admin beyond the built-in defaults.
model CustomRole {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  @@unique([universeId, name])
  @@index([universeId])
}

// --- Character Relationships ---
// Directed edge: fromCharacter has [type] relationship with toCharacter.
// Both must belong to the same universe (enforced at app level).
// type: "relative" | "friend" | "enemy"
// note: optional short label e.g. "brother", "rival"
model CharacterRelationship {
  id              String    @id @default(cuid())
  fromCharacterId String
  toCharacterId   String
  fromCharacter   Character @relation("RelFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter     Character @relation("RelTo",   fields: [toCharacterId],   references: [id], onDelete: Cascade)
  type            String    // "relative" | "friend" | "enemy"
  note            String?

  createdAt       DateTime  @default(now())

  @@index([fromCharacterId])
  @@index([toCharacterId])
}

// --- Storyline Ideas ---
model StorylineIdea {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title      String
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- General Notes ---
model Note {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title      String
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- Locations ---
// Place profiles. locatedIn is free text describing where in the world.
// climate, atmosphere, description, and notes are all optional long-form fields.
model Location {
  id          String   @id @default(cuid())
  universeId  String
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  name        String
  locatedIn   String?  // where it sits within the world (free text)
  climate     String?  // weather / climate
  atmosphere  String?  // feel / atmosphere
  description String?  // what the place is like
  notes       String?  // general notes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([universeId])
}

// --- Images ---
// Binary image data stored directly in PostgreSQL so it survives redeploys.
// Images are compressed client-side before upload (see ImageUploader).
// data is the compressed JPEG bytes. mimeType is always image/jpeg after compression.
// category: "book cover" | "sketch" | "character art" | "map" | "reference" | "other"
model Image {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  label      String
  category   String   @default("other")
  mimeType   String   @default("image/jpeg")
  data       Bytes
  works      Work[]   // books that use this as cover art
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- Plot Checklist ---
// Universe-wide checklist. Checked items display small/grey at the bottom.
model PlotItem {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  text       String
  checked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([universeId])
}

// --- Site Settings ---
// Singleton record (id = "singleton") storing site-wide public settings.
// eyebrow: small uppercase label at top of About page (e.g. "ABOUT THE AUTHOR").
// headline: large heading on About page (e.g. "Alexandra Castalia").
// bio: body text, plain text (paragraphs split by \n\n).
// photoData: compressed JPEG bytes for the page photo, served via /api/site/photo.
model SiteSettings {
  id        String   @id @default("singleton")
  eyebrow   String?
  headline  String?
  bio       String?
  photoData Bytes?
  updatedAt DateTime @updatedAt
}

// --- Author Profiles ---
// One per user. status: "pending" | "approved" | "rejected".
// Approved profiles appear on the public Our Authors page.
model AuthorProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eyebrowText String?
  headline    String?
  bodyText    String?
  photoData   Bytes?
  status      String    @default("pending")
  submittedAt DateTime  @default(now())
  approvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// --- Join Requests ---
// Submitted by prospective authors via the /write-with-us page.
// All boolean fields capture explicit checkbox confirmations from the applicant.
// termsVersion records which version of the Terms they agreed to (e.g. "June 2026").
// ipAddress is captured at submission time for legal record-keeping.
// status: "pending" | "approved" | "rejected"
model JoinRequest {
  id                     String    @id @default(cuid())
  fullName               String
  email                  String
  requestedUsername      String
  genres                 String    // comma-separated list
  aboutYou               String
  existingWorkLink       String?
  howDidYouHear          String?
  confirmedAge           Boolean
  confirmedOriginalAuthor Boolean
  confirmedPlagiarism    Boolean
  confirmedApproval      Boolean
  confirmedPersonalUse   Boolean
  confirmedRightToRefuse Boolean
  confirmedTerms         Boolean
  termsVersion           String
  ipAddress              String
  submittedAt            DateTime  @default(now())
  status                 String    @default("pending")
  reviewedAt             DateTime?

  @@index([status])
  @@index([submittedAt])
}

// --- Feedback Messages ---
// Submitted by public visitors via the Feedback popup.
// read: false = unread/new; true = admin has handled it.
model FeedbackMessage {
  id        String          @id @default(cuid())
  name      String
  email     String?
  message   String
  read      Boolean         @default(false)
  createdAt DateTime        @default(now())
  shares    FeedbackShare[]
}

model FeedbackShare {
  id                String          @id @default(cuid())
  feedbackMessageId String
  feedbackMessage   FeedbackMessage @relation(fields: [feedbackMessageId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedAt          DateTime        @default(now())

  @@unique([feedbackMessageId, userId])
  @@index([feedbackMessageId])
  @@index([userId])
}

// --- Mailing List ---
// Email addresses collected via the public Subscribe popup.
// email is unique so duplicates are detected and rejected gracefully.
model MailingListEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// --- Works (Books and Short Stories) ---
// type: "book" | "short story"
// status: "private" | "published"
// publishMode: null (private) | "whole" | "snippet"
//   "whole"   — the full content field is public
//   "snippet" — only the snippet field is public; content stays private
// snippet: HTML text chosen by the author as a public teaser (set when publishMode="snippet")
// content: rich text stored as HTML (populated by TipTap editor, next stage)
// coverImageId: optional reference to an Image in the same universe (books only)
// openCount: incremented each time a public visitor opens the work (read-tracking)
// publishedAt: set when status first changes to "published"
model Work {
  id           String    @id @default(cuid())
  universeId   String
  universe     Universe  @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title        String
  type         String    // "book" | "short story"
  content      String?   // TipTap HTML; null until first save in editor
  status       String    @default("private")
  publishMode  String?   // "whole" | "snippet" | null
  snippet      String?   // public teaser text/HTML when publishMode="snippet"
  coverImageId String?
  coverImage   Image?    @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  description  String?   // Short synopsis for public book/story listing
  buyLinks     String?   // JSON: [{label: string, url: string}[]]
  publishedAt  DateTime?
  openCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chapters            Chapter[]
  flags               Flag[]
  shares              WorkShare[]
  freeReadSubmission      FreeReadSubmission?
  discoverBooksSubmission DiscoverBooksSubmission?

  @@index([universeId])
  @@index([coverImageId])
}

// --- Work Shares ---
// Grants a specific user comment-only (read) access to a single work.
// Created by the work's universe owner/editor; lets the sharer collect
// feedback on a story without exposing the rest of the universe.
model WorkShare {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([workId, userId])
  @@index([workId])
  @@index([userId])
}

// --- Species ---
// Custom species beyond the built-in defaults (Human, Vampire, etc.).
// Stored per universe. Defaults are hardcoded client-side.
// color: hex string (e.g. "#9e4a6c"); shape: "circle"|"triangle"|"diamond"|"square"
model Species {
  id         String   @id @default(cuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  name       String
  color      String
  shape      String   // "circle" | "triangle" | "diamond" | "square"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([universeId, name])
  @@index([universeId])
}

// --- Chapters ---
// A work is divided into chapters. order is 0-based and used for display ordering.
// content stores TipTap HTML; null until first keystroke in that chapter.
// When a work's editor is opened for the first time after this feature was added,
// the server seeds one chapter from Work.content (may be null/empty).
model Chapter {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  title     String   @default("Chapter 1")
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flags     Flag[]

  @@index([workId])
  @@index([workId, order])
}

// --- Free Read Submissions ---
// One per work. status: "pending" | "approved" | "rejected".
// Approved submissions appear on the public Start Reading page.
// submissionType: "chapters" | "full"
// selectedChapterIds: JSON array of Chapter IDs (only when type="chapters")
// coverImageData: Sharp-compressed JPEG bytes, served via /api/free-read-cover/[id]
// coverBgIndex: 1-10, references /public/cover-backgrounds/cover-bg-N.jpg
model FreeReadSubmission {
  id                 String    @id @default(cuid())
  workId             String    @unique
  work               Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionType     String    // "chapters" | "full"
  selectedChapterIds String?   // JSON: string[]
  title              String
  description        String
  contentRating      String    // "General" | "Teen" | "Mature Themes" | "Adult"
  coverImageData     Bytes?
  coverBgIndex       Int?
  status             String    @default("pending")
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  publishedAt        DateTime?
  likes              FreeReadLike[]

  @@index([status])
}

// --- Free Read Likes ---
// One row per (submission, IP). Prevents duplicate likes without requiring login.
model FreeReadLike {
  id           String             @id @default(cuid())
  submissionId String
  submission   FreeReadSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ipAddress    String
  createdAt    DateTime           @default(now())

  @@unique([submissionId, ipAddress])
  @@index([submissionId])
}

// --- Discover Books Submissions ---
// One per work. status: "pending" | "approved" | "rejected".
// Approved submissions appear on the public Discover Books page.
// coverImageData: author-uploaded cover (binary, compressed via Sharp)
// coverBgIndex: 1-10, which preset background was chosen (null if uploading own cover)
// When coverBgIndex is set, the bookTitle + authorName are overlaid on the background.
model DiscoverBooksSubmission {
  id               String    @id @default(cuid())
  workId           String    @unique
  work             Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookTitle        String
  authorName       String
  coverImageData   Bytes?
  coverBgIndex     Int?
  purchaseUrl      String
  purchaseLinkText String
  description      String
  contentRating    String    // "General" | "Teen" | "Mature Themes" | "Adult"
  status           String    @default("pending")
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  publishedAt      DateTime?
  likes            DiscoverBooksLike[]

  @@index([status])
}

// --- Discover Books Likes ---
// One row per (submission, IP). Prevents duplicate likes without requiring login.
model DiscoverBooksLike {
  id           String                  @id @default(cuid())
  submissionId String
  submission   DiscoverBooksSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ipAddress    String
  createdAt    DateTime                @default(now())

  @@unique([submissionId, ipAddress])
  @@index([submissionId])
}

// --- Writing Flags ---
// Inline annotations placed by the author on specific text spans within a chapter.
// fromOffset / toOffset are plain-text character offsets within the chapter content.
// color: "yellow" = revisit, "red" = urgent fix.
// snippet: the flagged text (up to 100 chars) for display in the flag list.
model Flag {
  id          String   @id @default(cuid())
  workId      String
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  color       String   // "yellow" | "red"
  fromOffset  Int
  toOffset    Int
  snippet     String
  createdAt   DateTime @default(now())

  @@index([workId])
  @@index([chapterId])
}
